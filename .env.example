# Qirabot configuration — copy to .env in your project directory.
# The CLI reads ./.env automatically; exported variables always win.
# All entries are optional.

# Google Cloud credentials (ADC); or run `gcloud auth application-default login`
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# GCP project for Vertex (default: the ADC credentials' own project)
# QIRA_VERTEX_PROJECT=my-project

# Vertex location (default: global)
# QIRA_VERTEX_LOCATION=us-central1

# Vertex AI API key — auth without ADC/gcloud (gemini-vertex models only,
# global endpoint; a Google Cloud key, not an AI Studio key)
# QIRA_VERTEX_API_KEY=...

# Gemini Developer API (AI Studio) key for the gemini provider
# (GEMINI_API_KEY is also read)
# QIRA_GEMINI_API_KEY=...

# Default model as "{provider}/{model}" — see `qirabot models`
# QIRA_MODEL=gemini-vertex/gemini-3.8-flash

# Screenshot detail sent to the model: low / medium / high / ultra_high
# (default: high — lower it to cut image tokens per step)
# QIRA_MEDIA_RESOLUTION=high
